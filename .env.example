# Copy to .env and fill in. `yarn dev:memory` needs none of this.
NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://localhost:27017/edmira

# Optional — without Redis, caching (pending sign-ups, logout blacklist) is in-process.
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

JWT_SECRET=change-me-access
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES_IN=7d

RESEND_API_KEY=re_xxx
MAIL_FROM=EdMira <no-reply@yourdomain.com>

# Comma-separated browser origins (e.g. the admin dashboard). Not needed for the mobile app.
ALLOWED_ORIGINS=

# Study-material uploads (slides, textbooks) — any S3-compatible store.
# Cloudflare R2: STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, STORAGE_REGION=auto
# Leave STORAGE_BUCKET empty to keep uploads off in production (links still work);
# in development files go to UPLOAD_DIR (default: a temp folder).
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
UPLOAD_DIR=

# AI features (question drafting and AI news). Leave empty to turn them off.
ANTHROPIC_API_KEY=
# AI news: at most NEWS_LIMIT new stories in any NEWS_LIMIT_HOURS window, however often
# sources are checked (timer, cron job or "Check sources now").
NEWS_LIMIT=4
NEWS_LIMIT_HOURS=48
# Check sources every N hours (0 = only "Check sources now" / yarn news:fetch),
# skip stories older than N days, and take at most N stories from one source per check.
NEWS_FETCH_EVERY_HOURS=48
NEWS_MAX_AGE_DAYS=14
NEWS_PER_SOURCE=2
