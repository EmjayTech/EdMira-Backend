# Copy to .env and fill in. `yarn dev:memory` needs none of this.
NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://localhost:27017/edmira

# Optional — without Redis, caching (pending sign-ups, logout blacklist) is in-process.
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

JWT_SECRET=change-me-access
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES_IN=7d

RESEND_API_KEY=re_xxx
MAIL_FROM=EdMira <no-reply@yourdomain.com>

# Comma-separated browser origins (e.g. the admin dashboard). Not needed for the mobile app.
ALLOWED_ORIGINS=
# The admin dashboard's public address, used in staff invite links (e.g. https://admin.edmira.org).
# Without it, links use the address of the dashboard the admin is using.
ADMIN_URL=

# Study-material uploads (slides, textbooks) — any S3-compatible store.
# Cloudflare R2: STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, STORAGE_REGION=auto
# Leave STORAGE_BUCKET empty to keep uploads off in production (links still work);
# in development files go to UPLOAD_DIR (default: a temp folder).
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Profile pictures live under avatars/ in the same bucket and are public. Point a
# CDN / R2 custom domain at the bucket and allow only the avatars/ prefix
# (materials/ stays private, signed links only). e.g. https://cdn.edmira.org
STORAGE_PUBLIC_URL=
UPLOAD_DIR=

# AI features (question drafting and AI news). Leave empty to turn them off.
ANTHROPIC_API_KEY=
# AI news: at most NEWS_LIMIT new stories in any NEWS_LIMIT_HOURS window, however often
# sources are checked (timer, cron job or "Check sources now").
NEWS_LIMIT=4
NEWS_LIMIT_HOURS=48
# Check sources every N hours (0 = only "Check sources now" / yarn news:fetch),
# skip stories older than N days, and take at most N stories from one source per check.
NEWS_FETCH_EVERY_HOURS=48
NEWS_MAX_AGE_DAYS=14
NEWS_PER_SOURCE=2
PUBLIC_API_URL=

# ── Pro payments ──
# Google Play Billing: service account JSON key (raw JSON or base64) with access to
# the app in Play Console (View financial data; Manage orders and subscriptions).
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=com.emjaytech.edmira
# Secret in the Pub/Sub push URL for Play notifications:
#   https://<api-host>/api/v1/billing/play/notifications?token=<PLAY_RTDN_TOKEN>
PLAY_RTDN_TOKEN=
# Paystack (web checkout). Webhook URL: https://<api-host>/api/v1/billing/paystack/webhook
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=https://edmira.org/pro/thanks
# Local testing without the stores: PLAY_FAKE=1 / PAYSTACK_FAKE=1 (never in production).
